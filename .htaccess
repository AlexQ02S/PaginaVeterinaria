# 1. Ocultar el listado de archivos si una carpeta no tiene archivo index
Options -Indexes

# 2. Forzar codificación UTF-8 para que las tildes y eñes no se rompan nunca
AddDefaultCharset UTF-8

# 3. Proteger archivos de configuración o base de datos sensibles contra accesos directos
<FilesMatch "(config|db_citas)\.php">
    Order deny,allow
    Deny from all
</FilesMatch>

# 4. Activar el motor de reescritura por si deseas usar URLs limpias en el futuro
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Ejemplo básico para quitar la extensión .php opcionalmente:
    # RewriteCond %{REQUEST_FILENAME} !-d
    # RewriteCond %{REQUEST_FILENAME}\.php -f
    # RewriteRule ^(.*)$ $1.php [L]
</IfModule>